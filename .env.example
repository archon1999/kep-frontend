VITE_API_URL=http://localhost:8000
# Optional Vite-only proxy for HTTP and WebSocket requests with same-origin cookies.
# VITE_API_URL must be the origin; generated endpoints already include /api/.
# For WebSockets, use a backend-allowed local origin and sign in for a session.
# Development Basic auth only authenticates HTTP requests.
VITE_DEV_API_PROXY=false
VITE_BASIC_AUTH_LOGIN=
VITE_BASIC_AUTH_PASSWORD=
VITE_WS_URL=ws://localhost:8000/ws/
